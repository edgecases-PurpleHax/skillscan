{
  "name": "@purplehaxttv/skillscan",
  "version": "0.1.1",
  "description": "SonarQube-style security scanner for Claude Code skill files",
  "type": "module",
  "bin": {
    "skillscan": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark": "tsx src/benchmark.ts",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "security",
    "claude",
    "claude-code",
    "prompt-injection",
    "skill",
    "scanner",
    "static-analysis",
    "sarif"
  ],
  "author": "purplehaxttv",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/edgecases-PurpleHax/skillscan.git"
  },
  "homepage": "https://github.com/edgecases-PurpleHax/skillscan#readme",
  "bugs": {
    "url": "https://github.com/edgecases-PurpleHax/skillscan/issues"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "glob": "^11.0.3",
    "js-yaml": "^4.1.0",
    "openai": "^4.104.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.32",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
